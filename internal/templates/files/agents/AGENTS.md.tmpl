#### `internal/bookmark/store.go`
{{if eq .ORM "gorm"}}
```go
package bookmark

import (
	"context"
	"errors"
	"fmt"

	"gorm.io/gorm"
)

type Store struct {
	db *gorm.DB
}

func NewStore(db *gorm.DB) *Store {
	return &Store{db: db}
}

// Migrate creates or updates the bookmarks table.
func (s *Store) Migrate(ctx context.Context) error {
	return s.db.WithContext(ctx).AutoMigrate(&Bookmark{})
}

func (s *Store) Get(ctx context.Context, id int64) (Bookmark, error) {
	var b Bookmark
	err := s.db.WithContext(ctx).First(&b, id).Error
	if errors.Is(err, gorm.ErrRecordNotFound) {
		return Bookmark{}, ErrNotFound
	}
	if err != nil {
		return Bookmark{}, fmt.Errorf("get bookmark %d: %w", id, err)
	}
	return b, nil
}

func (s *Store) Create(ctx context.Context, b Bookmark) (Bookmark, error) {
	if err := s.db.WithContext(ctx).Create(&b).Error; err != nil {
		return Bookmark{}, fmt.Errorf("create bookmark: %w", err)
	}
	return b, nil
}
```

GORM maps `Bookmark` to a `bookmarks` table and `ID` to its primary key. Use
`AutoMigrate` for new tables and query through `s.db.WithContext(ctx)` so
cancellation reaches the database.
{{else if eq .ORM "xorm"}}
```go
package bookmark

import (
	"context"
	"fmt"

	"xorm.io/xorm"
)

type Store struct {
	db *xorm.Engine
}

func NewStore(db *xorm.Engine) *Store {
	return &Store{db: db}
}

// Migrate creates or updates the bookmark table.
func (s *Store) Migrate(ctx context.Context) error {
	return s.db.Sync(new(Bookmark))
}

func (s *Store) Get(ctx context.Context, id int64) (Bookmark, error) {
	var b Bookmark
	has, err := s.db.Context(ctx).ID(id).Get(&b)
	if err != nil {
		return Bookmark{}, fmt.Errorf("get bookmark %d: %w", id, err)
	}
	if !has {
		return Bookmark{}, ErrNotFound
	}
	return b, nil
}

func (s *Store) Create(ctx context.Context, b Bookmark) (Bookmark, error) {
	if _, err := s.db.Context(ctx).Insert(&b); err != nil {
		return Bookmark{}, fmt.Errorf("create bookmark: %w", err)
	}
	return b, nil
}
```

XORM maps `Bookmark` to a `bookmark` table using the `xorm` struct tags. Create
tables with `s.db.Sync`, and query through `s.db.Context(ctx)`. `Get` reports a
missing row as `has == false`, not as an error.
{{else}}
```go
package bookmark

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
)

type Store struct {
	db *sql.DB
}

func NewStore(db *sql.DB) *Store {
	return &Store{db: db}
}

// Migrate creates the bookmarks table if it does not exist.
func (s *Store) Migrate(ctx context.Context) error {
	_, err := s.db.ExecContext(ctx, `CREATE TABLE IF NOT EXISTS bookmarks (
{{- if eq .Database "postgres"}}
		id    BIGSERIAL PRIMARY KEY,
{{- else if eq .Database "mysql"}}
		id    BIGINT AUTO_INCREMENT PRIMARY KEY,
{{- else}}
		id    INTEGER PRIMARY KEY AUTOINCREMENT,
{{- end}}
		url   TEXT NOT NULL,
		title TEXT NOT NULL
	)`)
	return err
}

func (s *Store) Get(ctx context.Context, id int64) (Bookmark, error) {
	var b Bookmark
	err := s.db.QueryRowContext(ctx,
		"SELECT id, url, title FROM bookmarks WHERE id = {{if eq .Database "postgres"}}$1{{else}}?{{end}}", id).
		Scan(&b.ID, &b.URL, &b.Title)
	if errors.Is(err, sql.ErrNoRows) {
		return Bookmark{}, ErrNotFound
	}
	if err != nil {
		return Bookmark{}, fmt.Errorf("get bookmark %d: %w", id, err)
	}
	return b, nil
}

func (s *Store) Create(ctx context.Context, b Bookmark) (Bookmark, error) {
{{- if eq .Database "postgres"}}
	err := s.db.QueryRowContext(ctx,
		"INSERT INTO bookmarks (url, title) VALUES ($1, $2) RETURNING id",
		b.URL, b.Title).Scan(&b.ID)
	if err != nil {
		return Bookmark{}, fmt.Errorf("create bookmark: %w", err)
	}
{{- else}}
	res, err := s.db.ExecContext(ctx,
		"INSERT INTO bookmarks (url, title) VALUES (?, ?)", b.URL, b.Title)
	if err != nil {
		return Bookmark{}, fmt.Errorf("create bookmark: %w", err)
	}
	if b.ID, err = res.LastInsertId(); err != nil {
		return Bookmark{}, fmt.Errorf("create bookmark: %w", err)
	}
{{- end}}
	return b, nil
}
```
{{if eq .Database "postgres"}}
Placeholders for Postgres are `$1, $2, ...`, never `?`. The `lib/pq` driver does
not support `LastInsertId`, so read new IDs with `RETURNING id`.
{{- else if eq .Database "mysql"}}
Placeholders for MySQL are `?`. Read new IDs with `res.LastInsertId()`.
{{- else}}
Placeholders for SQLite are `?`. Read new IDs with `res.LastInsertId()`.
{{- end}} Always use
the `...Context` methods, and check for `sql.ErrNoRows` with `errors.Is`.
{{end}}
{{- if eq .ORM "ent"}}
Ent was selected, but stores start on `database/sql` (the code above), because an
Ent schema is specific to your data. To move a feature to Ent, run
`go run -mod=mod entgo.io/ent/cmd/ent new Bookmark`, edit
`ent/schema/bookmark.go`, and run `go generate ./ent`. Then build the client from
the existing pool in `cmd/main.go`, for example
`ent.NewClient(ent.Driver(entsql.OpenDB(dialect.{{if eq .Database "postgres"}}Postgres{{else if eq .Database "mysql"}}MySQL{{else}}SQLite{{end}}, config.DB)))`,
and pass it to `NewStore` in place of `*sql.DB`. Keep the store's method
signatures, so the service and handler do not change.
{{end}}
#### `internal/bookmark/service.go`

```go
package bookmark

import (
	"context"
	"fmt"
	"strings"
)

// store is what the service needs from the data layer. Tests can pass a fake.
type store interface {
	Get(ctx context.Context, id int64) (Bookmark, error)
	Create(ctx context.Context, b Bookmark) (Bookmark, error)
}

type Service struct {
	store store
}

func NewService(store store) *Service {
	return &Service{store: store}
}

func (s *Service) Get(ctx context.Context, id int64) (Bookmark, error) {
	return s.store.Get(ctx, id)
}

func (s *Service) Create(ctx context.Context, b Bookmark) (Bookmark, error) {
	b.URL = strings.TrimSpace(b.URL)
	if b.URL == "" {
		return Bookmark{}, fmt.Errorf("%w: url is required", ErrInvalid)
	}
	return s.store.Create(ctx, b)
}
```

