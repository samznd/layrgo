		ctx.StopWithJSON(http.StatusBadRequest, iris.Map{"error": "invalid JSON body"})
		return
	}
	b, err := h.service.Create(ctx.Request().Context(), in)
	if err != nil {
		status, msg := errorStatus(err)
		ctx.StopWithJSON(status, iris.Map{"error": msg})
