{{else}}
func (h *Handler) Get(w http.ResponseWriter, r *http.Request) {
	id, err := strconv.ParseInt({{if eq .Framework "chi"}}chi.URLParam(r, "id"){{else}}r.PathValue("id"){{end}}, 10, 64)
	if err != nil {
		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid id"})
		return
	}
	b, err := h.service.Get(r.Context(), id)
	if err != nil {
		status, msg := errorStatus(err)
		writeJSON(w, status, map[string]string{"error": msg})
		return
	}
	writeJSON(w, http.StatusOK, b)
}

func (h *Handler) Create(w http.ResponseWriter, r *http.Request) {
	var in Bookmark
	if err := json.NewDecoder(r.Body).Decode(&in); err != nil {
		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "invalid JSON body"})
		return
	}
	b, err := h.service.Create(r.Context(), in)
	if err != nil {
		status, msg := errorStatus(err)
		writeJSON(w, status, map[string]string{"error": msg})
		return
	}
	writeJSON(w, http.StatusCreated, b)
}

func writeJSON(w http.ResponseWriter, status int, v any) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	_ = json.NewEncoder(w).Encode(v)
}
{{end}}
// errorStatus maps a service error to an HTTP status and a message that is
// safe to show clients.
func errorStatus(err error) (int, string) {
	switch {
	case errors.Is(err, ErrNotFound):
		return http.StatusNotFound, "not found"
	case errors.Is(err, ErrInvalid):
		return http.StatusBadRequest, err.Error()
	default:
		return http.StatusInternalServerError, "internal server error"
	}
}
```

#### `internal/bookmark/routes.go`

```go
package bookmark
{{if eq .Framework "gin"}}
import (
	"github.com/gin-gonic/gin"
)

func SetupRoutes(api *gin.RouterGroup, h *Handler) {
	api.POST("/bookmarks", h.Create)
	api.GET("/bookmarks/:id", h.Get)
}
```

`cmd/main.go` creates the `/api/v1` group and passes it to every feature, so
register routes **without** that prefix: `/bookmarks/:id`, not
`/api/v1/bookmarks/:id`. Path parameters use `:id` and are read with
`c.Param("id")`.
{{- else if eq .Framework "echo"}}
import (
	"github.com/labstack/echo/v4"
)

func SetupRoutes(api *echo.Group, h *Handler) {
	api.POST("/bookmarks", h.Create)
	api.GET("/bookmarks/:id", h.Get)
}
```

`cmd/main.go` creates the `/api/v1` group and passes it to every feature, so
register routes **without** that prefix: `/bookmarks/:id`, not
`/api/v1/bookmarks/:id`. Path parameters use `:id` and are read with
`c.Param("id")`.
{{- else if eq .Framework "fiber"}}
import (
	"github.com/gofiber/fiber/v3"
)

func SetupRoutes(api fiber.Router, h *Handler) {
	api.Post("/bookmarks", h.Create)
	api.Get("/bookmarks/:id", h.Get)
}
```

`cmd/main.go` creates the `/api/v1` group and passes it to every feature, so
register routes **without** that prefix: `/bookmarks/:id`, not
`/api/v1/bookmarks/:id`. Path parameters use `:id` and are read with
`c.Params("id")`.
{{- else if eq .Framework "chi"}}
import (
	"github.com/go-chi/chi/v5"
)

func SetupRoutes(r chi.Router, h *Handler) {
	r.Route("/api/v1/bookmarks", func(r chi.Router) {
		r.Post("/", h.Create)
		r.Get("/{id}", h.Get)
	})
}
```

Each feature receives the root router and mounts its own prefix.
**Do not** call `r.Route("/api/v1", ...)` again in a new feature: `internal/message` already
mounts that path, and chi panics when two features mount the same one. Path
parameters use `{id}` and are read with `chi.URLParam(r, "id")`.
{{- else if eq .Framework "iris"}}
import (
	"github.com/kataras/iris/v12"
)

func SetupRoutes(app *iris.Application, h *Handler) {
	api := app.Party("/api/v1/bookmarks")
	api.Post("/", h.Create)
	api.Get("/{id}", h.Get)
}
```

Each feature receives the application and creates its own party, here
`app.Party("/api/v1/bookmarks")`. Path parameters use `{id}` and are read with
`ctx.Params().Get("id")`.
{{- else}}
import (
	"net/http"
)

func SetupRoutes(mux *http.ServeMux, h *Handler) {
	mux.HandleFunc("POST /api/v1/bookmarks", h.Create)
	mux.HandleFunc("GET /api/v1/bookmarks/{id}", h.Get)
}
```

Patterns carry the method and the full path, `/api/v1` included. Path parameters
use `{id}` and are read with `r.PathValue("id")`. This routing needs Go 1.22 or
newer, and `ServeMux` panics at startup if two patterns conflict.
{{- end}}

### 2. Wire it in `cmd/main.go`

Add the `"{{.Module}}/internal/bookmark"` import, then add the feature above the
`// layrgo:wire` marker. Prefix each variable with the feature name:

```go
	bookmarkStore := bookmark.NewStore(config.DB)
	if err := bookmarkStore.Migrate(context.Background()); err != nil {
		log.Fatalf("migrate bookmarks: %v", err)
	}
	bookmarkService := bookmark.NewService(bookmarkStore)
	bookmarkHandler := bookmark.NewHandler(bookmarkService)
```

and register its routes above the `// layrgo:routes` marker:

```go
	bookmark.SetupRoutes({{.RouterVar}}, bookmarkHandler)
```

### 3. Test it

Test business rules in the service with a fake store, in
`internal/bookmark/service_test.go`:

```go
package bookmark

import (
	"context"
	"errors"
	"testing"
)

type fakeStore struct{}

func (fakeStore) Get(ctx context.Context, id int64) (Bookmark, error) {
	return Bookmark{}, ErrNotFound
}

func (fakeStore) Create(ctx context.Context, b Bookmark) (Bookmark, error) {
	b.ID = 1
	return b, nil
}

func TestCreate_RequiresURL(t *testing.T) {
	s := NewService(fakeStore{})
	if _, err := s.Create(context.Background(), Bookmark{URL: "  "}); !errors.Is(err, ErrInvalid) {
		t.Fatalf("err = %v, want ErrInvalid", err)
	}
}
```

Then run the checks from [Commands](#commands), start the server, and try the
endpoints:

```bash
curl -X POST http://localhost:3000/api/v1/bookmarks \
  -H 'Content-Type: application/json' -d '{"url":"https://go.dev","title":"Go"}'
curl http://localhost:3000/api/v1/bookmarks/1
```
