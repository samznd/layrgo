package config

import (
	"fmt"
	"log"
	"os"
	"time"

	{{.DriverImport}}
	"gorm.io/gorm"
)

var DB *gorm.DB

// Connect opens the database and checks it is reachable.
func Connect() error {
	{{.DSNBlock}}

	db, err := gorm.Open({{.GormDialector}}, &gorm.Config{})
	if err != nil {
		return fmt.Errorf("open database: %w", err)
	}

	sqlDB, err := db.DB()
	if err != nil {
		return fmt.Errorf("access underlying pool: %w", err)
	}

	// Cap the pool so a busy app can't use up the database's connections.
	// Tune these for your workload.
	sqlDB.SetMaxOpenConns(25)
	sqlDB.SetMaxIdleConns(5)
	sqlDB.SetConnMaxLifetime(5 * time.Minute)
	sqlDB.SetConnMaxIdleTime(time.Minute)

	if err := sqlDB.Ping(); err != nil {
		return fmt.Errorf("ping database: %w", err)
	}

	DB = db
	log.Println("connected to database")
	return nil
}

// Close releases the pool. Safe to call when Connect never succeeded.
func Close() {
	if DB == nil {
		return
	}
	sqlDB, err := DB.DB()
	if err != nil {
		return
	}
	if err := sqlDB.Close(); err != nil {
		log.Printf("close database: %v", err)
	}
}

var _ = os.Getenv
