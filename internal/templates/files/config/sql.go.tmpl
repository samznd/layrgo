package config

import (
	"database/sql"
	"fmt"
	"log"
	"os"
	"time"

	{{.DriverImport}}
)

var DB *sql.DB

// Connect opens the database and verifies it is reachable. It returns an error
// rather than exiting, so the caller decides how to handle failure.
func Connect() error {
	{{.DSNBlock}}

	db, err := sql.Open({{.DriverName}}, dsn)
	if err != nil {
		return fmt.Errorf("open database: %w", err)
	}

	// Pool limits: an unbounded pool is a common way to exhaust a database's
	// connection slots under load. Tune these for your workload.
	db.SetMaxOpenConns(25)
	db.SetMaxIdleConns(5)
	db.SetConnMaxLifetime(5 * time.Minute)
	db.SetConnMaxIdleTime(time.Minute)

	if err := db.Ping(); err != nil {
		db.Close()
		return fmt.Errorf("ping database: %w", err)
	}

	DB = db
	log.Println("connected to database")
	return nil
}

// Close releases the pool. Safe to call when Connect never succeeded.
func Close() {
	if DB == nil {
		return
	}
	if err := DB.Close(); err != nil {
		log.Printf("close database: %v", err)
	}
}

var _ = os.Getenv
