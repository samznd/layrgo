package {{.Package}}

import (
{{- if eq .Framework "gin"}}
	"github.com/gin-gonic/gin"
{{- else if eq .Framework "echo"}}
	"github.com/labstack/echo/v4"
{{- else if eq .Framework "fiber"}}
	"github.com/gofiber/fiber/v3"
{{- else if eq .Framework "chi"}}
	"github.com/go-chi/chi/v5"
{{- else if eq .Framework "iris"}}
	"github.com/kataras/iris/v12"
{{- else}}
	"net/http"
{{- end}}
)
{{if eq .Framework "gin"}}
// SetupRoutes registers the {{.Package}} routes on the /api/v1 group from cmd/main.go.
func SetupRoutes(api *gin.RouterGroup, h *Handler) {
	api.POST("/{{.Plural}}", h.Create)
	api.GET("/{{.Plural}}", h.List)
	api.GET("/{{.Plural}}/:id", h.Get)
}
{{- else if eq .Framework "echo"}}
// SetupRoutes registers the {{.Package}} routes on the /api/v1 group from cmd/main.go.
func SetupRoutes(api *echo.Group, h *Handler) {
	api.POST("/{{.Plural}}", h.Create)
	api.GET("/{{.Plural}}", h.List)
	api.GET("/{{.Plural}}/:id", h.Get)
}
{{- else if eq .Framework "fiber"}}
// SetupRoutes registers the {{.Package}} routes on the /api/v1 group from cmd/main.go.
func SetupRoutes(api fiber.Router, h *Handler) {
	api.Post("/{{.Plural}}", h.Create)
	api.Get("/{{.Plural}}", h.List)
	api.Get("/{{.Plural}}/:id", h.Get)
}
{{- else if eq .Framework "chi"}}
// SetupRoutes mounts the {{.Package}} routes under /api/v1/{{.Plural}}.
func SetupRoutes(r chi.Router, h *Handler) {
	r.Route("/api/v1/{{.Plural}}", func(r chi.Router) {
		r.Post("/", h.Create)
		r.Get("/", h.List)
		r.Get("/{id}", h.Get)
	})
}
{{- else if eq .Framework "iris"}}
// SetupRoutes registers the {{.Package}} routes under /api/v1/{{.Plural}}.
func SetupRoutes(app *iris.Application, h *Handler) {
	api := app.Party("/api/v1/{{.Plural}}")
	api.Post("/", h.Create)
	api.Get("/", h.List)
	api.Get("/{id}", h.Get)
}
{{- else}}
// SetupRoutes registers the {{.Package}} routes. "GET /path" patterns need Go 1.22+.
func SetupRoutes(mux *http.ServeMux, h *Handler) {
	mux.HandleFunc("POST /api/v1/{{.Plural}}", h.Create)
	mux.HandleFunc("GET /api/v1/{{.Plural}}", h.List)
	mux.HandleFunc("GET /api/v1/{{.Plural}}/{id}", h.Get)
}
{{- end}}
