// {{.Package}}Service is the part of the service this handler uses.
type {{.Package}}Service interface {
	Create(ctx context.Context, item {{.Type}}) ({{.Type}}, error)
	List(ctx context.Context) ([]{{.Type}}, error)
	Get(ctx context.Context, id int64) ({{.Type}}, error)
}

type Handler struct {
	service {{.Package}}Service
}

func NewHandler(s {{.Package}}Service) *Handler {
	return &Handler{service: s}
}
{{if eq .Framework "gin"}}
func (h *Handler) Create(c *gin.Context) {
	var in {{.Type}}
	if err := c.ShouldBindJSON(&in); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid JSON body"})
		return
	}
	item, err := h.service.Create(c.Request.Context(), in)
	if err != nil {
		status, msg := errorStatus(err)
		c.JSON(status, gin.H{"error": msg})
		return
	}
	c.JSON(http.StatusCreated, item)
}

func (h *Handler) List(c *gin.Context) {
	items, err := h.service.List(c.Request.Context())
	if err != nil {
		status, msg := errorStatus(err)
		c.JSON(status, gin.H{"error": msg})
		return
	}
	c.JSON(http.StatusOK, items)
}

func (h *Handler) Get(c *gin.Context) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid id"})
		return
	}
	item, err := h.service.Get(c.Request.Context(), id)
	if err != nil {
		status, msg := errorStatus(err)
		c.JSON(status, gin.H{"error": msg})
		return
	}
	c.JSON(http.StatusOK, item)
}
