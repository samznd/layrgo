package message

import (
	"context"
	"fmt"

	"xorm.io/xorm"
)

// Store is the data access for messages.
type Store struct {
	engine *xorm.Engine
}

func NewStore(engine *xorm.Engine) *Store {
	return &Store{engine: engine}
}

func (s *Store) GetMessage(ctx context.Context) (string, error) {
	rows, err := s.engine.Context(ctx).QueryString("SELECT 'data from the store' AS message")
	if err != nil {
		return "", err
	}
	if len(rows) == 0 {
		return "", fmt.Errorf("no rows returned")
	}
	return rows[0]["message"], nil
}
