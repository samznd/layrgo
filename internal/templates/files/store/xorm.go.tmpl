package message

import (
	"context"
	"fmt"

	"xorm.io/xorm"
)

// Message is a row in the message table.
type Message struct {
	ID   int64  `xorm:"pk autoincr 'id'"`
	Body string `xorm:"'body' notnull"`
}

// Store is the data access for messages.
type Store struct {
	db *xorm.Engine
}

func NewStore(db *xorm.Engine) *Store {
	return &Store{db: db}
}

// Migrate creates the message table and seeds it with one row. cmd/main.go
// calls it at startup; give every feature that owns a table a Migrate like it.
func (s *Store) Migrate(ctx context.Context) error {
	if err := s.db.Sync(new(Message)); err != nil {
		return fmt.Errorf("migrate messages: %w", err)
	}
	n, err := s.db.Context(ctx).Count(new(Message))
	if err != nil {
		return fmt.Errorf("count messages: %w", err)
	}
	if n > 0 {
		return nil
	}
	if _, err := s.db.Context(ctx).Insert(&Message{Body: "data from the store"}); err != nil {
		return fmt.Errorf("seed messages: %w", err)
	}
	return nil
}

func (s *Store) GetMessage(ctx context.Context) (string, error) {
	var m Message
	has, err := s.db.Context(ctx).Get(&m)
	if err != nil {
		return "", fmt.Errorf("get message: %w", err)
	}
	if !has {
		return "", fmt.Errorf("get message: no rows")
	}
	return m.Body, nil
}
