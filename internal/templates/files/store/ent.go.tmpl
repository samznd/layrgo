package message

// Ent schema code is project-specific. Run 'ent init' to generate it, then
// replace this database/sql version with the Ent client.

import (
	"context"
	"database/sql"
)

// Store is the data access for messages.
type Store struct {
	db *sql.DB
}

func NewStore(db *sql.DB) *Store {
	return &Store{db: db}
}

func (s *Store) GetMessage(ctx context.Context) (string, error) {
	var message string
	if err := s.db.QueryRowContext(ctx, "SELECT 'data from the store'").Scan(&message); err != nil {
		return "", err
	}
	return message, nil
}
