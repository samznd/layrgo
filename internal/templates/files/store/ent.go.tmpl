package message

// Ent schema code is project-specific. Run 'ent init' to generate it, then
// replace this database/sql version with the Ent client.

import (
	"context"
	"database/sql"
	"fmt"
)

// Store is the data access for messages.
type Store struct {
	db *sql.DB
}

func NewStore(db *sql.DB) *Store {
	return &Store{db: db}
}

// Migrate creates the messages table and seeds it with one row. cmd/main.go
// calls it at startup; give every feature that owns a table a Migrate like it.
func (s *Store) Migrate(ctx context.Context) error {
	if _, err := s.db.ExecContext(ctx,
		"CREATE TABLE IF NOT EXISTS messages (body TEXT NOT NULL)"); err != nil {
		return fmt.Errorf("create messages table: %w", err)
	}
	var n int
	if err := s.db.QueryRowContext(ctx, "SELECT COUNT(*) FROM messages").Scan(&n); err != nil {
		return fmt.Errorf("count messages: %w", err)
	}
	if n > 0 {
		return nil
	}
	if _, err := s.db.ExecContext(ctx,
		"INSERT INTO messages (body) VALUES ('data from the store')"); err != nil {
		return fmt.Errorf("seed messages: %w", err)
	}
	return nil
}

func (s *Store) GetMessage(ctx context.Context) (string, error) {
	var message string
	if err := s.db.QueryRowContext(ctx, "SELECT body FROM messages LIMIT 1").Scan(&message); err != nil {
		return "", fmt.Errorf("get message: %w", err)
	}
	return message, nil
}
