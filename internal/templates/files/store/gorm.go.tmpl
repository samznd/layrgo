package message

import (
	"context"
	"fmt"

	"gorm.io/gorm"
)

// Message is a row in the messages table.
type Message struct {
	ID   uint
	Body string `gorm:"not null"`
}

// Store is the data access for messages.
type Store struct {
	db *gorm.DB
}

func NewStore(db *gorm.DB) *Store {
	return &Store{db: db}
}

// Migrate creates the messages table and seeds it with one row. cmd/main.go
// calls it at startup; give every feature that owns a table a Migrate like it.
func (s *Store) Migrate(ctx context.Context) error {
	db := s.db.WithContext(ctx)
	if err := db.AutoMigrate(&Message{}); err != nil {
		return fmt.Errorf("migrate messages: %w", err)
	}
	var n int64
	if err := db.Model(&Message{}).Count(&n).Error; err != nil {
		return fmt.Errorf("count messages: %w", err)
	}
	if n > 0 {
		return nil
	}
	if err := db.Create(&Message{Body: "data from the store"}).Error; err != nil {
		return fmt.Errorf("seed messages: %w", err)
	}
	return nil
}

func (s *Store) GetMessage(ctx context.Context) (string, error) {
	var m Message
	if err := s.db.WithContext(ctx).First(&m).Error; err != nil {
		return "", fmt.Errorf("get message: %w", err)
	}
	return m.Body, nil
}
