package message

import (
	"context"
	"database/sql"
)

// Store is a concrete type. The service that uses it declares the
// interface it needs, so there is no interface here to keep in sync.
type Store struct {
	db *sql.DB
}

func NewStore(db *sql.DB) *Store {
	return &Store{db: db}
}

func (s *Store) GetMessage(ctx context.Context) (string, error) {
	var message string
	if err := s.db.QueryRowContext(ctx, "SELECT 'data from the store'").Scan(&message); err != nil {
		return "", err
	}
	return message, nil
}
