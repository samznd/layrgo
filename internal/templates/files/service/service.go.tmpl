package message

import "context"

// store is what the service needs from the data layer. Tests can pass a fake.
type store interface {
	GetMessage(ctx context.Context) (string, error)
}

type Service struct {
	store store
}

func NewService(store store) *Service {
	return &Service{store: store}
}

// GetMessage just reads from the store for now. Business rules go here.
func (s *Service) GetMessage(ctx context.Context) (string, error) {
	return s.store.GetMessage(ctx)
}
