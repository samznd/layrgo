package message

import "context"

// store is what this service needs from the data layer. It is
// declared here, next to the code that uses it, and kept as small as that code
// requires. Any type with a matching GetMessage method satisfies it, which is
// what lets a test pass in a fake without a real database.
type store interface {
	GetMessage(ctx context.Context) (string, error)
}

type Service struct {
	store store
}

// NewService accepts an interface and returns a concrete type.
func NewService(store store) *Service {
	return &Service{store: store}
}

// GetMessage only forwards to the store for now. Business rules
// (validation, combining several data sources, transactions) belong here.
func (s *Service) GetMessage(ctx context.Context) (string, error) {
	return s.store.GetMessage(ctx)
}
