package message

import (
	"context"
	"net/http"

	"github.com/labstack/echo/v4"
)

// messageService is what this handler needs from the service layer. Go
// interfaces are satisfied implicitly, so the consumer declares them: the
// handler depends on one small behaviour, not on a concrete service type.
type messageService interface {
	GetMessage(ctx context.Context) (string, error)
}

type Handler struct {
	service messageService
}

func NewHandler(s messageService) *Handler {
	return &Handler{service: s}
}

func (h *Handler) Get(c echo.Context) error {
	message, err := h.service.GetMessage(c.Request().Context())
	if err != nil {
		return c.JSON(http.StatusInternalServerError, map[string]string{"error": "internal server error"})
	}
	return c.JSON(http.StatusOK, map[string]string{"message": message})
}
